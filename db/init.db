CREATE DATABASE IF NOT EXISTS cho_ptiters
    CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE cho_ptiters;

SET FOREIGN_KEY_CHECKS = 0;
DROP TABLE IF EXISTS tblOrderStatusHistory;
DROP TABLE IF EXISTS tblOrderItem;
DROP TABLE IF EXISTS tblOrder;
DROP TABLE IF EXISTS tblProductImage;
DROP TABLE IF EXISTS tblProduct;
DROP TABLE IF EXISTS tblCategory;
DROP TABLE IF EXISTS tblUser;
SET FOREIGN_KEY_CHECKS = 1;

-- 1. Nguoi dung (Module 1, 2)
CREATE TABLE tblUser (
    userId     INT AUTO_INCREMENT PRIMARY KEY,
    publicId   VARCHAR(30)  NOT NULL UNIQUE,
    username   VARCHAR(50)  NOT NULL UNIQUE,
    password   VARCHAR(100) NOT NULL,
    email      VARCHAR(100) NOT NULL UNIQUE,
    fullName   VARCHAR(100) NOT NULL,
    phone      VARCHAR(15)  NULL,
    status     VARCHAR(20)  NOT NULL DEFAULT 'ACTIVE',
    role       VARCHAR(20)  NOT NULL DEFAULT 'STUDENT'
);

-- 2. Danh muc (Module 2)
CREATE TABLE tblCategory (
    categoryId INT AUTO_INCREMENT PRIMARY KEY,
    slug       VARCHAR(100) NOT NULL UNIQUE,
    name       VARCHAR(100) NOT NULL,
    isDeleted  BOOLEAN NOT NULL DEFAULT FALSE
);

-- 3. San pham / tin dang
CREATE TABLE tblProduct (
    productId        INT AUTO_INCREMENT PRIMARY KEY,
    sellerId         INT NOT NULL,
    categoryId       INT NOT NULL,
    title            VARCHAR(200) NOT NULL,
    description      TEXT NULL,
    price            FLOAT NOT NULL,
    stock            INT NOT NULL DEFAULT 1,
    reservedStock    INT NOT NULL DEFAULT 0,
    status           VARCHAR(20) NOT NULL DEFAULT 'AVAILABLE',
    approvalStatus   VARCHAR(20) NOT NULL DEFAULT 'PENDING',
    moderationStatus VARCHAR(20) NOT NULL DEFAULT 'CLEAR',
    isDeleted        BOOLEAN NOT NULL DEFAULT FALSE,
    CONSTRAINT fk_product_seller   FOREIGN KEY (sellerId)   REFERENCES tblUser(userId),
    CONSTRAINT fk_product_category FOREIGN KEY (categoryId) REFERENCES tblCategory(categoryId)
);

-- 4. Hinh anh san pham
CREATE TABLE tblProductImage (
    imageId     INT AUTO_INCREMENT PRIMARY KEY,
    productId   INT NOT NULL,
    imageUrl    VARCHAR(500) NOT NULL,
    isThumbnail BOOLEAN NOT NULL DEFAULT FALSE,
    sortOrder   INT NOT NULL DEFAULT 0,
    CONSTRAINT fk_image_product FOREIGN KEY (productId) REFERENCES tblProduct(productId) ON DELETE CASCADE
);

-- 5. Don hang
CREATE TABLE tblOrder (
    orderId           INT AUTO_INCREMENT PRIMARY KEY,
    buyerId           INT NOT NULL,
    sellerId          INT NOT NULL,
    status            VARCHAR(20) NOT NULL DEFAULT 'PENDING',
    fulfillmentMethod VARCHAR(20) NOT NULL DEFAULT 'MEETUP',
    paymentMethod     VARCHAR(30) NOT NULL DEFAULT 'CASH_ON_MEETUP',
    paymentStatus     VARCHAR(20) NOT NULL DEFAULT 'UNPAID',
    meetupPlace       VARCHAR(255) NULL,
    cancelledBy       INT NULL,
    cancelReason      VARCHAR(500) NULL,
    contactName       VARCHAR(100) NULL,
    contactPhone      VARCHAR(15)  NULL,
    note              VARCHAR(500) NULL,
    completedAt       DATETIME NULL,
    CONSTRAINT fk_order_buyer  FOREIGN KEY (buyerId)  REFERENCES tblUser(userId),
    CONSTRAINT fk_order_seller FOREIGN KEY (sellerId) REFERENCES tblUser(userId)
);

-- 6. Chi tiet mat hang trong don
CREATE TABLE tblOrderItem (
    orderItemId     INT AUTO_INCREMENT PRIMARY KEY,
    orderId         INT NOT NULL,
    productId       INT NOT NULL,
    productTitle    VARCHAR(200) NOT NULL,
    quantity        INT NOT NULL,
    priceAtPurchase FLOAT NOT NULL,
    CONSTRAINT fk_item_order   FOREIGN KEY (orderId)   REFERENCES tblOrder(orderId) ON DELETE CASCADE,
    CONSTRAINT fk_item_product FOREIGN KEY (productId) REFERENCES tblProduct(productId)
);

-- 7. Lich su trang thai don
CREATE TABLE tblOrderStatusHistory (
    historyId  INT AUTO_INCREMENT PRIMARY KEY,
    orderId    INT NOT NULL,
    fromStatus VARCHAR(30) NULL,
    toStatus   VARCHAR(30) NOT NULL,
    changedBy  INT NULL,
    createdAt  DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    tblOrderId INT NULL,
    tblUserId  INT NULL,
    CONSTRAINT fk_hist_order FOREIGN KEY (orderId) REFERENCES tblOrder(orderId) ON DELETE CASCADE
);

